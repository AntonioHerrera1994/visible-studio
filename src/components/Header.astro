---
import { getCollection } from 'astro:content';
import Eyes from './Eyes.astro';
import PaletteSwitcher from './PaletteSwitcher.astro';
import { BLOG_ENABLED, type Lang, t, route, languages, contact } from '../i18n/ui';

interface Props {
  lang: Lang;
  alternates: Record<Lang, string>;
}
const { lang, alternates } = Astro.props;
const path = Astro.url.pathname;
const other = lang === 'es' ? 'en' : 'es';

const services = (await getCollection('services', (s) => s.data.lang === lang && s.data.kind === 'core'))
  .sort((a, b) => a.data.order - b.data.order);
const svcBase = route(lang, 'services');

const nav = [
  { href: route(lang, 'work'), label: t(lang, 'nav.work') },
  { href: route(lang, 'industries'), label: t(lang, 'nav.industries') },
  { href: route(lang, 'about'), label: t(lang, 'nav.about') },
  ...(BLOG_ENABLED ? [{ href: route(lang, 'blog'), label: t(lang, 'nav.blog') }] : []),
];

const dd = {
  es: { all: 'Ver todos los servicios', local: 'Servicios en Tijuana', cardTitle: '¿Qué tan visible eres?', cardText: 'Seis preguntas, un minuto.', cardCta: 'Haz el diagnóstico' },
  en: { all: 'See all services', local: 'Services in Tijuana', cardTitle: 'How visible are you?', cardText: 'Six questions, one minute.', cardCta: 'Take the check' },
}[lang];
const isServices = path.startsWith(svcBase);
---

<header class="header">
  <div class="header__inner wrap">
    <a class="logo" href={route(lang, 'home')} aria-label="Visible Studio" transition:persist="logo">
      <span class="logo__eyes"><Eyes variant="mini" /></span>
      <span class="logo__word">visible studio</span>
    </a>

    <nav class="nav" aria-label={lang === 'es' ? 'Principal' : 'Main'}>
      <ul>
        <li><a href={nav[0].href} aria-current={path.startsWith(nav[0].href) ? 'page' : undefined}>{nav[0].label}</a></li>
        <li class="nav__dd" data-dd>
          <button
            class="nav__trigger"
            popovertarget="services-menu"
            aria-current={isServices ? 'page' : undefined}
            data-dd-trigger
          >
            {t(lang, 'nav.services')}
            <svg class="chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
          <div id="services-menu" popover class="dd" data-dd-panel>
            <ul class="dd__list">
              {services.map((s, i) => (
                <li style={`--i:${i}`}>
                  <a href={`${svcBase}${s.data.slug}/`} class="dd__item">
                    <strong>{s.data.h1}</strong>
                    <span>{s.data.problem}</span>
                  </a>
                </li>
              ))}
            </ul>
            <a class="dd__card" href={route(lang, 'audit')} data-eyes-attract>
              <span class="dd__eyes"><Eyes variant="mini" /></span>
              <strong>{dd.cardTitle}</strong>
              <span>{dd.cardText}</span>
              <span class="dd__cta">{dd.cardCta}</span>
            </a>
            <div class="dd__foot">
              <a href={svcBase}>{dd.all}</a>
              {lang === 'es' && <a href={`${svcBase}marketing-medico-tijuana/`}>{dd.local}</a>}
            </div>
          </div>
        </li>
        {nav.slice(1).map((item) => (
          <li>
            <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header__actions">
      <PaletteSwitcher lang={lang} />
      <a class="lang" href={alternates[other]} hreflang={other} lang={other} aria-label={languages[other]}>
        <span aria-hidden="true">{other.toUpperCase()}</span>
      </a>
      <a class="btn btn--primary header__cta" href={route(lang, 'audit')} data-eyes-attract>
        {t(lang, 'nav.cta')}
      </a>
      <button class="menu-btn" popovertarget="mobile-menu" aria-label={t(lang, 'nav.menu')}>
        <span></span><span></span>
      </button>
    </div>
  </div>

  <!--
    Menú móvil tipo "bottom sheet": sube desde abajo, deja ver la página difuminada detrás
    y pone las acciones principales en la zona del pulgar. Se cierra con el botón, tocando fuera,
    con Esc o deslizando la hoja hacia abajo.
  -->
  <div id="mobile-menu" popover class="mm" data-mm>
    <div class="mm__sheet" data-mm-sheet>
      <div class="mm__grab" data-mm-grab aria-hidden="true"><span></span></div>

      <div class="mm__top">
        <span class="mm__eyes"><Eyes variant="mini" /></span>
        <div class="mm__lang" role="group" aria-label={lang === 'es' ? 'Idioma' : 'Language'}>
          <a href={alternates.es} hreflang="es" lang="es" aria-current={lang === 'es' ? 'true' : undefined}>ES</a>
          <a href={alternates.en} hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
        </div>
      </div>

      <nav class="mm__nav" aria-label={lang === 'es' ? 'Menú móvil' : 'Mobile menu'}>
        <ul>
          <li style="--i:0">
            <a href={nav[0].href} aria-current={path.startsWith(nav[0].href) ? 'page' : undefined}>
              {nav[0].label}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
            </a>
          </li>
          <li style="--i:1">
            <details class="mm__acc" open={isServices}>
              <summary aria-current={isServices ? 'page' : undefined}>
                {t(lang, 'nav.services')}<span class="mm__plus" aria-hidden="true"></span>
              </summary>
              <ul class="mm__chips">
                {services.map((s) => (
                  <li><a href={`${svcBase}${s.data.slug}/`} aria-current={path.startsWith(`${svcBase}${s.data.slug}/`) ? 'page' : undefined}>{s.data.h1}</a></li>
                ))}
                <li><a class="mm__chip-all" href={svcBase}>{dd.all}</a></li>
              </ul>
            </details>
          </li>
          {nav.slice(1).map((item, i) => (
            <li style={`--i:${i + 2}`}>
              <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                {item.label}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="mm__palette"><PaletteSwitcher lang={lang} variant="inline" /></div>

      <div class="mm__bar">
        <button class="mm__close" popovertarget="mobile-menu" popovertargetaction="hide" aria-label={t(lang, 'nav.close')}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
        </button>
        <a class="mm__cta" href={route(lang, 'audit')}>{t(lang, 'nav.cta')}</a>
        <a class="mm__wa" href={`https://wa.me/${contact.whatsapp}`} rel="noopener" aria-label="WhatsApp">
          <svg viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3Zm0 23.6a10.6 10.6 0 0 1-5.4-1.5l-.4-.2-3.9 1 1-3.8-.2-.4A10.6 10.6 0 1 1 16 26.6Zm5.8-7.9c-.3-.2-1.9-.9-2.2-1s-.5-.2-.7.2-.8 1-1 1.2-.4.2-.7 0a8.7 8.7 0 0 1-4.3-3.7c-.3-.6.3-.5.9-1.7a.6.6 0 0 0 0-.5l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6a1.2 1.2 0 0 0-.9.4 3.7 3.7 0 0 0-1.1 2.7 6.4 6.4 0 0 0 1.3 3.4 14.7 14.7 0 0 0 5.6 5c2.1.9 2.9 1 4 .8a3.4 3.4 0 0 0 2.2-1.6 2.8 2.8 0 0 0 .2-1.6c-.1-.1-.3-.2-.6-.3Z"/></svg>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  /**
   * Dropdown de Servicios: popover nativo + anchor positioning.
   * En escritorio abre al pasar el cursor (con una pequeña pausa para no abrir por accidente);
   * con clic, teclado o toque funciona igual gracias al popover. Esc y clic afuera lo cierran.
   */
  const anchorSupported = CSS.supports('anchor-name: --a');

  function placeFallback(panel: HTMLElement, trigger: HTMLElement, align: 'left' | 'right') {
    if (anchorSupported) return;
    const r = trigger.getBoundingClientRect();
    panel.style.position = 'fixed';
    panel.style.top = `${r.bottom + 10}px`;
    if (align === 'left') panel.style.left = `${Math.max(16, r.left - 12)}px`;
    else panel.style.left = `${Math.max(16, r.right - panel.offsetWidth)}px`;
  }

  function initNav() {
    const dd = document.querySelector<HTMLElement>('[data-dd]');
    if (!dd || dd.dataset.ready) return;
    dd.dataset.ready = '1';
    const trigger = dd.querySelector<HTMLButtonElement>('[data-dd-trigger]')!;
    const panel = dd.querySelector<HTMLElement>('[data-dd-panel]')!;
    const canHover = window.matchMedia('(hover: hover) and (pointer: fine)');
    let openT = 0;
    let closeT = 0;

    const open = () => { if (!panel.matches(':popover-open')) panel.showPopover(); };
    const close = () => { if (panel.matches(':popover-open')) panel.hidePopover(); };

    panel.addEventListener('toggle', (e) => {
      const isOpen = (e as ToggleEvent).newState === 'open';
      trigger.setAttribute('aria-expanded', String(isOpen));
      if (isOpen) placeFallback(panel, trigger, 'left');
    });

    for (const el of [trigger, panel]) {
      el.addEventListener('pointerenter', () => {
        if (!canHover.matches) return;
        clearTimeout(closeT);
        openT = window.setTimeout(open, 90);
      });
      el.addEventListener('pointerleave', () => {
        if (!canHover.matches) return;
        clearTimeout(openT);
        closeT = window.setTimeout(close, 220);
      });
    }

    // Selector de paleta: mismo posicionamiento de respaldo.
    const pTrigger = document.querySelector<HTMLElement>('[data-palette-trigger]');
    const pPanel = document.querySelector<HTMLElement>('[data-palette-panel]');
    pPanel?.addEventListener('toggle', (e) => {
      const isOpen = (e as ToggleEvent).newState === 'open';
      pTrigger?.setAttribute('aria-expanded', String(isOpen));
      if (isOpen && pTrigger) placeFallback(pPanel, pTrigger, 'right');
    });

    initSheet();
  }

  /** Hoja del menú móvil: se cierra al tocar un enlace, tocando fuera o deslizándola hacia abajo. */
  function initSheet() {
    const menu = document.getElementById('mobile-menu');
    const sheet = menu?.querySelector<HTMLElement>('[data-mm-sheet]');
    if (!menu || !sheet || menu.dataset.ready) return;
    menu.dataset.ready = '1';

    menu.querySelectorAll<HTMLAnchorElement>('a').forEach((a) => a.addEventListener('click', () => menu.hidePopover()));
    // Tocar el fondo difuminado (fuera de la hoja) cierra el menú
    menu.addEventListener('click', (e) => { if (e.target === menu) menu.hidePopover(); });
    // Bloquea el scroll de la página mientras el menú está abierto
    menu.addEventListener('toggle', (e) => {
      document.documentElement.style.overflow = (e as ToggleEvent).newState === 'open' ? 'hidden' : '';
      sheet.style.translate = '';
    });

    // Deslizar hacia abajo para cerrar (desde la manija o la parte superior)
    let startY = 0, dy = 0, dragging = false;
    const zone = sheet.querySelector<HTMLElement>('.mm__top')!;
    const grab = sheet.querySelector<HTMLElement>('[data-mm-grab]')!;
    for (const el of [grab, zone]) {
      el.addEventListener('pointerdown', (e) => {
        if ((e.target as Element).closest('a, button')) return;
        dragging = true; startY = e.clientY; dy = 0;
        sheet.classList.add('is-dragging');
        el.setPointerCapture(e.pointerId);
      });
      el.addEventListener('pointermove', (e) => {
        if (!dragging) return;
        dy = Math.max(0, e.clientY - startY);
        sheet.style.translate = `0 ${dy}px`;
      });
      const end = () => {
        if (!dragging) return;
        dragging = false;
        sheet.classList.remove('is-dragging');
        if (dy > 110) menu.hidePopover();
        else sheet.style.translate = '';
      };
      el.addEventListener('pointerup', end);
      el.addEventListener('pointercancel', end);
    }
  }
  document.addEventListener('astro:page-load', initNav);
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--header-bg);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
    transition: background-color 0.4s;
  }
  .header__inner { display: flex; align-items: center; gap: 2rem; min-height: 4.5rem; }
  .logo {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    font-weight: 800;
    font-size: 1.3rem;
    letter-spacing: -0.04em;
    font-stretch: 78%;
    white-space: nowrap;
  }
  .logo__eyes { width: 3.1rem; }
  .nav { margin-right: auto; }
  .nav > ul { display: flex; gap: 0.25rem; list-style: none; margin: 0; padding: 0; }
  .nav > ul > li > a,
  .nav__trigger {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0.8rem;
    border-radius: var(--radius-pill);
    text-decoration: none;
    font: inherit;
    font-weight: 550;
    color: color-mix(in srgb, var(--fg) 82%, var(--bg));
    background: none;
    border: 0;
    cursor: pointer;
  }
  .nav > ul > li > a:hover,
  .nav > ul > li > a[aria-current='page'],
  .nav__trigger:hover,
  .nav__trigger[aria-current='page'],
  .nav__trigger[aria-expanded='true'] { color: var(--fg); background: var(--hover); }
  .chev { width: 0.75rem; transition: rotate 0.25s var(--ease-out); }
  .nav__trigger[aria-expanded='true'] .chev { rotate: 180deg; }

  /* ---- Dropdown híbrido: servicios + tarjeta de diagnóstico ---- */
  .nav__trigger { anchor-name: --services; }
  .dd {
    position-anchor: --services;
    position-area: bottom span-right;
    position-try-fallbacks: flip-inline;
    inset: auto;
    margin: 0.6rem 0 0 -0.75rem;
    width: min(680px, calc(100vw - 2rem));
    padding: 0.75rem;
    border: 1px solid var(--line-strong);
    border-radius: 24px;
    background: var(--bg);
    color: var(--fg);
    box-shadow: 0 30px 80px -30px rgb(0 0 0 / 0.55);
    display: none;
    grid-template-columns: 1.55fr 1fr;
    grid-template-areas: 'list card' 'foot foot';
    gap: 0.5rem;
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity 0.2s, transform 0.3s var(--ease-out), display 0.3s allow-discrete, overlay 0.3s allow-discrete;
  }
  .dd:popover-open { display: grid; opacity: 1; transform: none; }
  @starting-style { .dd:popover-open { opacity: 0; transform: translateY(-8px); } }

  .dd__list { grid-area: list; list-style: none; margin: 0; padding: 0; display: grid; gap: 0.15rem; }
  .dd__list li {
    opacity: 0;
    translate: -6px 0;
    transition: opacity 0.3s, translate 0.35s var(--ease-out);
    transition-delay: calc(var(--i) * 40ms + 60ms);
  }
  .dd:popover-open .dd__list li { opacity: 1; translate: 0 0; }
  @starting-style { .dd:popover-open .dd__list li { opacity: 0; translate: -6px 0; } }
  .dd__item {
    display: grid;
    gap: 0.1rem;
    padding: 0.75rem 0.9rem;
    border-radius: 14px;
    text-decoration: none;
    line-height: 1.3;
  }
  .dd__item strong { font-weight: 700; }
  .dd__item span { color: var(--muted); font-size: var(--step--1); }
  .dd__item:hover, .dd__item:focus-visible { background: var(--hover); }
  .dd__item:hover strong { color: var(--accent); }

  .dd__card {
    grid-area: card;
    display: grid;
    align-content: end;
    gap: 0.2rem;
    padding: 1.1rem;
    border-radius: 18px;
    background: var(--accent);
    color: var(--on-accent);
    text-decoration: none;
    line-height: 1.3;
    --eye-brow: var(--on-accent);
    transition: transform 0.3s var(--ease-out);
  }
  .dd__card:hover { transform: translateY(-2px); }
  .dd__eyes { width: 4.5rem; margin-bottom: auto; padding-bottom: 1.5rem; }
  .dd__card strong { font-size: var(--step-1); font-stretch: 85%; letter-spacing: -0.01em; }
  .dd__card span:not(.dd__eyes) { font-size: var(--step--1); }
  .dd__cta { margin-top: 0.6rem; font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }

  .dd__foot {
    grid-area: foot;
    display: flex;
    gap: 1.25rem;
    padding: 0.75rem 0.9rem 0.25rem;
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
    font-weight: 600;
  }
  .dd__foot a { text-decoration: none; color: var(--muted); }
  .dd__foot a:hover { color: var(--fg); }

  .header__actions { display: flex; align-items: center; gap: 0.6rem; }
  .lang {
    font-weight: 700;
    font-size: var(--step--1);
    text-decoration: none;
    padding: 0.5rem 0.7rem;
    border: 1.5px solid var(--line-strong);
    border-radius: var(--radius-pill);
  }
  .lang:hover { border-color: var(--fg); }
  .header__cta { padding: 0.75em 1.2em; font-size: 0.95rem; }

  .menu-btn {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1.5px solid var(--line-strong);
    background: none;
    cursor: pointer;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 6px;
  }
  .menu-btn span { width: 18px; height: 2px; background: var(--fg); border-radius: 2px; }

  /* ---- Menú móvil: bottom sheet ---- */
  .mm {
    inset: 0;
    width: 100%;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    display: none;
    align-items: flex-end;
    overflow: hidden;
  }
  .mm:popover-open { display: flex; }
  .mm::backdrop {
    background: rgb(0 0 0 / 0.45);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    opacity: 0;
    transition: opacity 0.35s, display 0.45s allow-discrete, overlay 0.45s allow-discrete;
  }
  .mm:popover-open::backdrop { opacity: 1; }
  @starting-style { .mm:popover-open::backdrop { opacity: 0; } }

  .mm__sheet {
    position: relative;
    width: 100%;
    max-height: calc(100dvh - 0.75rem);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 0.5rem var(--gutter) 0;
    border-radius: 28px 28px 0 0;
    background: var(--accent);
    color: var(--on-accent);
    --eye-brow: var(--on-accent);
    box-shadow: 0 -20px 60px -10px rgb(0 0 0 / 0.4);
    overflow-y: auto;
    overscroll-behavior: contain;
    transform: translateY(100%);
    transition: transform 0.55s cubic-bezier(0.32, 0.72, 0, 1), translate 0.3s var(--ease-out);
  }
  .mm:popover-open .mm__sheet { transform: none; }
  @starting-style { .mm:popover-open .mm__sheet { transform: translateY(100%); } }
  .mm__sheet.is-dragging { transition: none; }

  .mm__grab { display: grid; place-items: center; padding: 0.35rem 0 0.15rem; cursor: grab; touch-action: none; }
  .mm__grab span { width: 44px; height: 5px; border-radius: 3px; background: color-mix(in srgb, var(--on-accent) 35%, transparent); }

  .mm__top { display: flex; align-items: center; justify-content: space-between; touch-action: none; }
  .mm__eyes { width: 3.6rem; }
  .mm__lang {
    display: inline-flex;
    padding: 4px;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--on-accent) 12%, transparent);
  }
  .mm__lang a {
    min-width: 3rem;
    padding: 0.5rem 0.85rem;
    border-radius: var(--radius-pill);
    text-align: center;
    text-decoration: none;
    font-weight: 750;
    font-size: 0.95rem;
  }
  .mm__lang a[aria-current] { background: var(--ink); color: var(--on-ink); }

  /* Navegación grande, pegada a la zona del pulgar */
  .mm__nav { flex: 1; display: flex; flex-direction: column; justify-content: flex-end; }
  .mm__nav > ul { list-style: none; margin: 0; padding: 0; }
  .mm__nav > ul > li {
    border-top: 1px solid color-mix(in srgb, var(--on-accent) 18%, transparent);
    opacity: 0;
    translate: 0 18px;
    transition: opacity 0.4s, translate 0.55s var(--ease-out);
    transition-delay: calc(var(--i) * 45ms + 160ms);
  }
  .mm:popover-open .mm__nav > ul > li { opacity: 1; translate: 0 0; }
  @starting-style { .mm:popover-open .mm__nav > ul > li { opacity: 0; translate: 0 18px; } }
  .mm__nav > ul > li > a,
  .mm__acc summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.75rem;
    font-size: clamp(1.9rem, 8.5vw, 2.6rem);
    font-weight: 780;
    font-stretch: 80%;
    letter-spacing: -0.03em;
    line-height: 1.05;
    text-decoration: none;
    cursor: pointer;
    list-style: none;
  }
  .mm__nav svg { width: 1.5rem; flex: none; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; opacity: 0.5; transition: translate 0.3s var(--ease-out), opacity 0.3s; }
  .mm__nav a:active svg { translate: 4px 0; opacity: 1; }
  .mm__nav [aria-current='page'] { text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 6px; }
  .mm__acc summary::-webkit-details-marker { display: none; }
  .mm__plus { position: relative; width: 1.5rem; height: 1.5rem; flex: none; }
  .mm__plus::before, .mm__plus::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1.1rem;
    height: 2.5px;
    border-radius: 2px;
    background: currentColor;
    translate: -50% -50%;
    transition: rotate 0.35s var(--ease-out);
  }
  .mm__plus::after { rotate: 90deg; }
  .mm__acc[open] .mm__plus::after { rotate: 0deg; }
