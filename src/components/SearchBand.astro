---
/**
 * Llamada a la acción "La búsqueda en vivo".
 * Una escena que se repite sola:
 *   1. El buscador escribe una búsqueda local ("dentista en Tijuana").
 *   2. Aparecen los resultados y "tu negocio" sube del #9 al #1.
 *   3. Cae un pin en el mapa.
 *   4. Llegan notificaciones: WhatsApp, reseña de 5 estrellas, cita, llamada.
 * Cada vuelta cambia de industria. Todo en HTML/CSS, así que toma los colores de la paleta activa.
 * Con movimiento reducido se muestra la escena final, quieta.
 */
import Eyes from './Eyes.astro';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  text: string;
  cta: string;
  href: string;
}
const { lang, text, cta, href } = Astro.props;

const copy = {
  es: {
    kicker: 'Así se ve cuando te encuentran',
    scenes: [
      { q: 'dentista en Tijuana', you: 'Tu clínica dental', meta: 'Abierto ahora, a 1.2 km', tag: 'Agenda por WhatsApp' },
      { q: 'casas en venta en Rosarito', you: 'Tu inmobiliaria', meta: '32 propiedades disponibles', tag: 'Tour virtual' },
      { q: 'restaurante cerca de mí', you: 'Tu restaurante', meta: 'Abierto, cierra a las 11 p. m.', tag: 'Reserva en línea' },
    ],
    notes: [
      ['whatsapp', 'WhatsApp', 'Hola, ¿tienen disponibilidad mañana?'],
      ['star', 'Nueva reseña', '★★★★★ “Súper recomendados”'],
      ['calendar', 'Cita agendada', 'Mañana, 10:30 a. m.'],
      ['phone', 'Llamada entrante', 'Desde Google Maps'],
    ],
    results: 'Resultados',
  },
  en: {
    kicker: 'This is what being found looks like',
    scenes: [
      { q: 'dentist in Tijuana', you: 'Your dental clinic', meta: 'Open now, 0.7 mi away', tag: 'Book on WhatsApp' },
      { q: 'homes for sale in Rosarito', you: 'Your real estate firm', meta: '32 listings available', tag: 'Virtual tour' },
      { q: 'restaurant near me', you: 'Your restaurant', meta: 'Open, closes at 11 p.m.', tag: 'Book online' },
    ],
    notes: [
      ['whatsapp', 'WhatsApp', 'Hi, do you have availability tomorrow?'],
      ['star', 'New review', '★★★★★ “Highly recommended”'],
      ['calendar', 'Appointment booked', 'Tomorrow, 10:30 a.m.'],
      ['phone', 'Incoming call', 'From Google Maps'],
    ],
    results: 'Results',
  },
}[lang];

const icons: Record<string, string> = {
  whatsapp: '<path d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M9 8.5c.3 2.6 2.4 5 5.5 6l1.2-1.4-2-1-.9.8a5 5 0 0 1-2.2-2.2l.8-.9-1-2L9 8.5Z" fill="currentColor"/>',
  star: '<path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9L12 3Z" fill="currentColor"/>',
  calendar: '<rect x="3.5" y="5" width="17" height="15" rx="3" fill="none" stroke="currentColor" stroke-width="2"/><path d="M8 3v4M16 3v4M3.5 10h17" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="m9 15 2 2 4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>',
  phone: '<path d="M6.6 3.5 9 3l1.5 4-2 1.5a11 11 0 0 0 7 7l1.5-2 4 1.5-.5 2.4A2.5 2.5 0 0 1 18 20 15 15 0 0 1 4 6a2.5 2.5 0 0 1 2.6-2.5Z" fill="currentColor"/>',
};
const scenes = JSON.stringify(copy.scenes);
---

<div class="sb" data-search-band data-scenes={scenes} data-reveal="scale">
  <div class="sb__copy">
    <p class="sb__kicker">{copy.kicker}</p>
    <p class="sb__text">{text}</p>
    <a class="btn btn--primary" href={href} data-eyes-attract data-magnetic>{cta}</a>
  </div>

  <div class="sb__stage" aria-hidden="true">
    <!-- Ventana del buscador -->
    <div class="sb__browser">
      <div class="sb__bar">
        <svg viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6" fill="none" stroke="currentColor" stroke-width="2.2" /><path d="m15 15 5 5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg>
        <span class="sb__query" data-query></span><span class="sb__caret"></span>
      </div>

      <p class="sb__label">{copy.results}</p>
      <ol class="sb__results" data-results>
        {[0, 1, 2, 3].map((i) => (
          <li class="sb__row" style={`--pos:${i}`} data-row>
            <span class="sb__rank">{i + 1}</span>
            <span class="sb__lines"><i style={`width:${70 - i * 8}%`}></i><i style={`width:${45 + i * 6}%`}></i></span>
            <span class="sb__stars sb__stars--dim">★★★☆☆</span>
          </li>
        ))}
        <li class="sb__row sb__row--you" style="--pos:4" data-you>
          <span class="sb__rank" data-rank>9</span>
          <span class="sb__avatar"><Eyes variant="mini" /></span>
          <span class="sb__you">
            <strong data-you-name></strong>
            <small data-you-meta></small>
          </span>
          <span class="sb__badge" data-you-tag></span>
          <span class="sb__stars">★ 4.9</span>
        </li>
      </ol>
    </div>

    <!-- Mapa con pin -->
    <div class="sb__map">
      <svg class="sb__streets" viewBox="0 0 200 120" preserveAspectRatio="none">
        <path d="M-10 80 C 40 70, 80 95, 210 60" /><path d="M30 -10 L 70 130" /><path d="M120 -10 C 110 40, 150 80, 140 130" />
        <path d="M-10 30 L 210 40" class="thin" /><path d="M-10 105 L 210 100" class="thin" />
      </svg>
      <span class="sb__pin">
        <svg viewBox="0 0 24 32"><path d="M12 31s10-11.2 10-19A10 10 0 0 0 2 12c0 7.8 10 19 10 19Z" /><circle cx="12" cy="12" r="4" /></svg>
      </span>
      <span class="sb__ripple"></span>
    </div>

    <!-- Notificaciones -->
    <ul class="sb__notes">
      {copy.notes.map(([icon, title, body], i) => (
        <li class="sb__note" style={`--n:${i}`}>
          <span class={`sb__ic sb__ic--${icon}`}><svg viewBox="0 0 24 24" set:html={icons[icon]} /></span>
          <span><strong>{title}</strong><small>{body}</small></span>
        </li>
      ))}
    </ul>
  </div>
</div>

<script>
  type Scene = { q: string; you: string; meta: string; tag: string };

  function startBand(root: HTMLElement) {
    if (root.dataset.ready) return;
    root.dataset.ready = '1';
    const scenes = JSON.parse(root.dataset.scenes!) as Scene[];
    const q = root.querySelector<HTMLElement>('[data-query]')!;
    const rank = root.querySelector<HTMLElement>('[data-rank]')!;
    const you = root.querySelector<HTMLElement>('[data-you]')!;
    const rows = [...root.querySelectorAll<HTMLElement>('[data-row]')];
    const set = (sel: string, txt: string) => (root.querySelector<HTMLElement>(sel)!.textContent = txt);
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let timers: number[] = [];
    let index = 0;
    let visible = false;
    let playing = false;
    const at = (ms: number, fn: () => void) => timers.push(window.setTimeout(fn, ms));
    const clear = () => { timers.forEach(clearTimeout); timers = []; };

    const fill = (s: Scene) => {
      set('[data-you-name]', s.you);
      set('[data-you-meta]', s.meta);
      set('[data-you-tag]', s.tag);
    };

    // Coloca las filas: "tu negocio" en `youPos`, los demás llenan los huecos.
    const order = (youPos: number) => {
      you.style.setProperty('--pos', String(youPos));
      rows.forEach((r, i) => r.style.setProperty('--pos', String(i < youPos ? i : i + 1)));
      rows.forEach((r, i) => (r.querySelector('.sb__rank')!.textContent = String(i < youPos ? i + 1 : i + 2)));
    };

    const finalState = () => {
      const s = scenes[0];
      fill(s);
      q.textContent = s.q;
      order(0);
      rank.textContent = '1';
      root.dataset.step = 'done';
    };

    function play() {
      clear();
      playing = true;
      const s = scenes[index % scenes.length];
      index++;
      root.dataset.step = 'type';
      fill(s);
      q.textContent = '';
      order(4);
      rank.textContent = '9';

      // 1. Escribe la búsqueda
      [...s.q].forEach((ch, i) => at(300 + i * 70, () => (q.textContent += ch)));
      const typed = 300 + s.q.length * 70;

      // 2. Resultados
      at(typed + 350, () => (root.dataset.step = 'results'));
      // 3. Sube al #1, con el número bajando 9 → 1
      at(typed + 1500, () => {
        root.dataset.step = 'climb';
        order(0);
        let n = 9;
        const tick = () => { rank.textContent = String(n); if (n-- > 1) at(70, tick); };
        tick();
      });
      // 4. Pin y notificaciones
      at(typed + 2500, () => (root.dataset.step = 'pin'));
      at(typed + 3100, () => (root.dataset.step = 'notes'));
      // 5. Pausa y vuelta a empezar con otra industria
      at(typed + 7600, () => (root.dataset.step = 'out'));
      at(typed + 8300, () => (visible ? play() : (playing = false)));
    }

    if (reduced) { finalState(); return; }
    finalState();
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible && !playing) play();
    }, { threshold: 0.35 }).observe(root);
  }

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-search-band]').forEach(startBand);
  });
</script>

<style>
  .sb {
    --panel: color-mix(in srgb, var(--on-ink) 7%, var(--ink));
    --panel-line: color-mix(in srgb, var(--on-ink) 14%, var(--ink));
    --dim: color-mix(in srgb, var(--on-ink) 45%, var(--ink));
    --ghost: color-mix(in srgb, var(--on-ink) 16%, var(--ink));
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
    padding: clamp(2rem, 5vw, 4rem);
    border-radius: 32px;
    background: var(--ink);
    color: var(--on-ink);
  }
  /* Resplandor de fondo */
  .sb::before {
    content: '';
    position: absolute;
    inset: auto -10% -40% 30%;
    height: 90%;
    z-index: -1;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--accent) 40%, transparent), transparent);
    filter: blur(10px);
  }

  .sb__copy { display: grid; gap: 1.5rem; justify-items: start; }
  .sb__kicker { color: var(--accent); font-weight: 650; }
  .sb__text {
    font-size: clamp(1.6rem, 3vw, 2.5rem);
    font-weight: 750;
    font-stretch: 84%;
    letter-spacing: -0.02em;
    line-height: 1.1;
    max-width: 18ch;
  }
  .sb__copy .btn { transition: translate 0.25s var(--ease-out), background-color 0.2s; }

  /* ---------- Escena ---------- */
  .sb__stage { position: relative; min-height: 440px; }

  .sb__browser {
    position: relative;
    width: min(100%, 520px);
    margin-left: auto;
    padding: 1.1rem;
    border-radius: 22px;
    background: var(--panel);
    border: 1px solid var(--panel-line);
    box-shadow: 0 30px 80px -30px rgb(0 0 0 / 0.6);
  }
  .sb__bar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.8rem 1rem;
    border-radius: var(--radius-pill);
    background: var(--ink);
    border: 1.5px solid var(--panel-line);
    font-weight: 600;
    min-height: 3.1rem;
    transition: border-color 0.3s;
  }
  [data-step='type'] .sb__bar { border-color: var(--accent); }
  .sb__bar svg { width: 1.15rem; flex: none; color: var(--dim); }
  .sb__caret { width: 2px; height: 1.2em; background: var(--accent); animation: blink 0.9s steps(1) infinite; margin-left: -0.45rem; }
  @keyframes blink { 50% { opacity: 0; } }

  .sb__label { margin: 1rem 0 0.5rem 0.25rem; font-size: var(--step--1); color: var(--dim); font-weight: 600; }

  .sb__results {
    --row: 3.6rem;
    --gap: 0.45rem;
    position: relative;
    height: calc(5 * var(--row) + 4 * var(--gap));
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sb__row {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(var(--pos) * (var(--row) + var(--gap)));
    height: var(--row);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0 0.85rem;
    border-radius: 14px;
    background: color-mix(in srgb, var(--on-ink) 4%, var(--ink));
    transition: top 0.9s cubic-bezier(0.65, 0, 0.25, 1), opacity 0.4s, translate 0.5s var(--ease-out), background-color 0.4s;
    opacity: 0;
    translate: 0 10px;
  }
  .sb__rank {
    flex: none;
    width: 1.7rem;
    height: 1.7rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--ghost);
    font-size: 0.8rem;
    font-weight: 750;
    font-variant-numeric: tabular-nums;
  }
  .sb__lines { flex: 1; display: grid; gap: 6px; }
  .sb__lines i { display: block; height: 7px; border-radius: 4px; background: var(--ghost); }
  .sb__lines i + i { height: 5px; opacity: 0.6; }
  .sb__stars { font-size: 0.8rem; font-weight: 700; color: var(--pop-2); white-space: nowrap; }
  .sb__stars--dim { color: var(--dim); letter-spacing: 1px; }

  .sb__row--you { z-index: 2; background: var(--accent); color: var(--on-accent); --eye-brow: var(--on-accent); }
  .sb__row--you .sb__rank { background: var(--on-accent); color: var(--accent); }
  .sb__row--you .sb__stars { color: inherit; }
  .sb__avatar {
    flex: none;
    width: 2.6rem;
    height: 2rem;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: var(--ink);
    padding: 0 4px;
  }
  .sb__you { flex: 1; min-width: 0; display: grid; line-height: 1.2; }
  .sb__you strong { font-size: 0.95rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sb__you small { font-size: 0.75rem; opacity: 0.8; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sb__badge {
    flex: none;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.25rem 0.55rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--on-accent) 16%, transparent);
  }

  /* Aparecen los resultados (escalonados) */
  .sb:is([data-step='results'], [data-step='climb'], [data-step='pin'], [data-step='notes'], [data-step='done']) .sb__row {
    opacity: 1;
    translate: 0 0;
  }
  .sb[data-step='results'] .sb__row { transition-delay: calc(var(--pos) * 70ms); }
  /* Al subir, "tu negocio" brilla */
  .sb:is([data-step='climb'], [data-step='pin'], [data-step='notes'], [data-step='done']) .sb__row--you {
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 35%, transparent), 0 18px 40px -12px color-mix(in srgb, var(--accent) 60%, transparent);
  }

  /* Mapa */
  .sb__map {
    position: absolute;
    left: 0;
    bottom: -0.5rem;
    width: 46%;
    max-width: 230px;
    aspect-ratio: 5 / 3.4;
    border-radius: 18px;
    overflow: hidden;
    background: color-mix(in srgb, var(--pop-1) 10%, var(--ink));
    border: 1px solid var(--panel-line);
    box-shadow: 0 24px 50px -20px rgb(0 0 0 / 0.7);
    opacity: 0;
    translate: -20px 20px;
    rotate: -4deg;
    transition: opacity 0.5s, translate 0.6s var(--ease-out), rotate 0.6s var(--ease-out);
  }
  .sb__streets { position: absolute; inset: 0; width: 100%; height: 100%; }
  .sb__streets path { fill: none; stroke: color-mix(in srgb, var(--on-ink) 22%, transparent); stroke-width: 6; }
  .sb__streets path.thin { stroke-width: 2; }
  .sb__pin {
    position: absolute;
    left: 50%;
    top: 45%;
    width: 30px;
    translate: -50% -100%;
    opacity: 0;
    transform: translateY(-60px);
  }
  .sb__pin path { fill: var(--accent); }
  .sb__pin circle { fill: var(--ink); }
  .sb__ripple {
    position: absolute;
    left: 50%;
    top: 45%;
    width: 60px;
    height: 22px;
    translate: -50% -50%;
    border-radius: 50%;
    border: 2px solid var(--accent);
    opacity: 0;
  }
  .sb:is([data-step='pin'], [data-step='notes'], [data-step='done']) .sb__map { opacity: 1; translate: 0 0; rotate: -4deg; }
  .sb:is([data-step='pin'], [data-step='notes']) .sb__pin { animation: drop 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) 0.25s forwards; }
  .sb[data-step='done'] .sb__pin { opacity: 1; transform: none; }
  .sb:is([data-step='pin'], [data-step='notes']) .sb__ripple { animation: ripple 1.6s var(--ease-out) 0.75s infinite; }
  @keyframes drop { from { opacity: 0; transform: translateY(-60px); } to { opacity: 1; transform: none; } }
  @keyframes ripple { from { opacity: 1; scale: 0.3; } to { opacity: 0; scale: 1.6; } }

  /* Notificaciones */
  .sb__notes {
    position: absolute;
    right: -0.5rem;
    bottom: 0;
    width: min(270px, 62%);
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }
  .sb__note {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.65rem 0.8rem;
    border-radius: 16px;
    background: color-mix(in srgb, var(--on-ink) 92%, var(--ink));
    color: var(--ink);
    box-shadow: 0 16px 40px -14px rgb(0 0 0 / 0.65);
    opacity: 0;
    translate: 30px 0;
    scale: 0.92;
    transition: opacity 0.4s, translate 0.55s var(--ease-spring), scale 0.55s var(--ease-spring);
  }
  .sb__note span:last-child { display: grid; line-height: 1.25; min-width: 0; }
  .sb__note strong { font-size: 0.8rem; }
  .sb__note small { font-size: 0.75rem; opacity: 0.75; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sb__ic { flex: none; width: 2rem; height: 2rem; border-radius: 10px; display: grid; place-items: center; color: #fff; }
  .sb__ic svg { width: 1.1rem; }
  .sb__ic--whatsapp { background: #25d366; }
  .sb__ic--star { background: #f5a524; }
  .sb__ic--calendar { background: var(--pop-1); }
  .sb__ic--phone { background: var(--accent); color: var(--on-accent); }
  .sb:is([data-step='notes'], [data-step='done']) .sb__note {
    opacity: 1;
    translate: 0 0;
    scale: 1;
    transition-delay: calc(var(--n) * 650ms);
  }
  .sb[data-step='done'] .sb__note { transition-delay: 0s; }

  /* Salida antes de repetir */
  .sb[data-step='out'] :is(.sb__row, .sb__map, .sb__note) { opacity: 0; transition-delay: 0s; transition-duration: 0.4s; }

  @media (max-width: 960px) {
    .sb { grid-template-columns: 1fr; }
    .sb__browser { margin-inline: auto; }
  }
  @media (max-width: 560px) {
    .sb { padding: 1.5rem 1.1rem 1.5rem; }
    .sb__stage { min-height: 0; padding-bottom: 12.5rem; }
    .sb__browser { padding: 0.8rem; }
    .sb__results { --row: 3.2rem; }
    .sb__badge { display: none; }
    .sb__map { width: 44%; bottom: 0; }
    .sb__notes { width: 64%; right: 0; bottom: 0.25rem; }
    .sb__note:nth-child(n + 4) { display: none; }
  }
</style>
