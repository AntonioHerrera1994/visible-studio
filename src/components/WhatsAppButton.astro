---
import { type Lang, t, contact } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const msg = lang === 'es' ? 'Hola, me interesa hacer visible mi negocio.' : 'Hi, I want to make my business more visible.';
---

<a
  class="wa"
  href={`https://wa.me/${contact.whatsapp}?text=${encodeURIComponent(msg)}`}
  rel="noopener"
  data-eyes-attract
  transition:persist="wa"
>
  <svg viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3Zm0 23.6a10.6 10.6 0 0 1-5.4-1.5l-.4-.2-3.9 1 1-3.8-.2-.4A10.6 10.6 0 1 1 16 26.6Zm5.8-7.9c-.3-.2-1.9-.9-2.2-1s-.5-.2-.7.2-.8 1-1 1.2-.4.2-.7 0a8.7 8.7 0 0 1-4.3-3.7c-.3-.6.3-.5.9-1.7a.6.6 0 0 0 0-.5l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6a1.2 1.2 0 0 0-.9.4 3.7 3.7 0 0 0-1.1 2.7 6.4 6.4 0 0 0 1.3 3.4 14.7 14.7 0 0 0 5.6 5c2.1.9 2.9 1 4 .8a3.4 3.4 0 0 0 2.2-1.6 2.8 2.8 0 0 0 .2-1.6c-.1-.1-.3-.2-.6-.3Z"/></svg>
  <span class="visually-hidden">{t(lang, 'whatsapp')}</span>
</a>

<style>
  .wa {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 40;
    width: 3.75rem;
    height: 3.75rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--accent);
    color: var(--on-accent);
    box-shadow: 0 0 0 4px var(--bg);
    transition: transform 0.3s var(--ease-out);
  }
  .wa:hover { transform: scale(1.08) rotate(-6deg); }
  .wa svg { width: 1.9rem; height: 1.9rem; }
</style>
