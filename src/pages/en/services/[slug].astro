---
import { getCollection } from 'astro:content';
import View from '../../../views/ServiceDetail.astro';
import { pathsFor } from '../../../lib/content';

export async function getStaticPaths() {
  return pathsFor(await getCollection('services'), 'en');
}
const { entry } = Astro.props;
---

<View lang="en" entry={entry} />
