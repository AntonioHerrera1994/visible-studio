---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import FinalCta from '../components/FinalCta.astro';
import { type Lang, t } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const copy = {
  es: {
    title: 'Nosotros: estudio creativo en Tijuana', description: 'Conoce al equipo de Visible Studio, estudio creativo de diseño y marketing digital en Tijuana.',
    h1: 'Un estudio, no una fábrica', lede: 'Trabajamos con pocos clientes a la vez para que cada proyecto tenga a las personas correctas de principio a fin.',
    believeTitle: 'En qué creemos',
    believe: [
      ['Primero el problema', 'No vendemos paquetes. Empezamos por lo que te está costando clientes.'],
      ['Diseño con datos', 'Cada decisión creativa se mide en llamadas, mensajes y ventas.'],
      ['Desde la frontera', 'Estamos en Tijuana y trabajamos en español e inglés para los dos lados.'],
    ],
    teamTitle: 'El equipo',
    team: [['Nombre', 'Dirección creativa'], ['Nombre', 'Estrategia y SEO'], ['Nombre', 'Desarrollo web']],
  },
  en: {
    title: 'About: creative studio in Tijuana', description: 'Meet the Visible Studio team, a creative design and digital marketing studio in Tijuana.',
    h1: 'A studio, not a factory', lede: 'We work with a few clients at a time so every project has the right people from start to finish.',
    believeTitle: 'What we believe',
    believe: [
      ['Problem first', 'We do not sell packages. We start with what is costing you customers.'],
      ['Design with data', 'Every creative decision is measured in calls, messages and sales.'],
      ['From the border', 'We are in Tijuana and work in Spanish and English for both sides.'],
    ],
    teamTitle: 'The team',
    team: [['Name', 'Creative direction'], ['Name', 'Strategy and SEO'], ['Name', 'Web development']],
  },
}[lang];
---

<Base lang={lang} title={copy.title} description={copy.description} alternates={{ es: '/es/nosotros/', en: '/en/about/' }}>
  <PageHero h1={copy.h1} lede={copy.lede} />

  <section class="section">
    <div class="wrap">
      <h2>{copy.believeTitle}</h2>
      <div class="believe">
        {copy.believe.map(([h, p]) => <div><h3>{h}</h3><p class="muted">{p}</p></div>)}
      </div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="wrap">
      <div class="head"><h2>{copy.teamTitle}</h2></div>
      <ul class="team">
        {copy.team.map(([name, role]) => (
          <li><div class="photo" aria-hidden="true"></div><strong>{name}</strong><span class="muted">{role}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <FinalCta lang={lang} />
</Base>

<style>
  .believe { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.5rem; margin-top: 3rem; }
  .believe h3 { margin-bottom: 0.75rem; }
  .head { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; margin-bottom: 2.5rem; }
  .team { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .team li { display: grid; gap: 0.25rem; }
  .photo { aspect-ratio: 4 / 5; border-radius: var(--radius-card); background: var(--card-placeholder); margin-bottom: 0.75rem; }
  @media (max-width: 760px) { .believe, .team { grid-template-columns: 1fr; } }
</style>
