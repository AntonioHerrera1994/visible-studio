---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import { type Lang, route } from '../i18n/ui';
import { alternatesFor } from '../lib/content';

/** Sin `entry` = listado de industrias. Con `entry` = página de una industria. */
interface Props { lang: Lang; entry?: CollectionEntry<'industries'> }
const { lang, entry } = Astro.props;
const list = (await getCollection('industries', (i) => i.data.lang === lang)).sort((a, b) => a.data.order - b.data.order);
const base = route(lang, 'industries');

const copy = {
  es: {
    title: 'Marketing por industria', description: 'Estrategias de diseño y marketing digital por industria: salud, inmobiliario, restaurantes y más.',
    h1: 'Cada industria se busca distinto', lede: 'Conocemos cómo buscan y deciden los clientes de cada sector. Elige el tuyo.',
    pains: 'Lo que escuchamos de negocios como el tuyo', cta: 'Agenda tu diagnóstico gratis',
  },
  en: {
    title: 'Marketing by industry', description: 'Design and digital marketing strategies by industry: healthcare, real estate, restaurants and more.',
    h1: 'Every industry gets searched differently', lede: 'We know how customers in each sector search and decide. Pick yours.',
    pains: 'What we hear from businesses like yours', cta: 'Book your free check',
  },
}[lang];

const alternates = entry
  ? await alternatesFor('industries', entry.data.key, 'industries')
  : { es: '/es/industrias/', en: '/en/industries/' };
---

{entry ? (
  <Base lang={lang} title={entry.data.title} description={entry.data.description} alternates={alternates}>
    <PageHero h1={entry.data.h1} lede={entry.data.lede}>
      <a class="btn btn--primary" href={route(lang, 'audit')} data-eyes-attract>{copy.cta}</a>
    </PageHero>
    {entry.data.pains.length > 0 && (
      <section class="section">
        <div class="wrap">
          <h2 class="pains__h">{copy.pains}</h2>
          <ul class="pains">{entry.data.pains.map((p) => <li>“{p}”</li>)}</ul>
        </div>
      </section>
    )}
    <Faq lang={lang} items={entry.data.faqs} />
    <FinalCta lang={lang} />
  </Base>
) : (
  <Base lang={lang} title={copy.title} description={copy.description} alternates={alternates}>
    <PageHero h1={copy.h1} lede={copy.lede} />
    <section class="section">
      <ul class="wrap ind">
        {list.map((i) => (
          <li>
            <a href={`${base}${i.data.slug}/`} data-eyes-attract>
              <h2>{i.data.h1}</h2>
              <p class="muted">{i.data.lede}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
    <FinalCta lang={lang} />
  </Base>
)}

<style>
  .pains__h { font-size: var(--step-2); margin-bottom: 2rem; }
  .pains { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .pains li {
    padding: 1.75rem; border-radius: var(--radius-card); background: var(--surface); color: var(--on-surface);
    font-size: var(--step-1); font-weight: 650; line-height: 1.3;
  }
  .ind { list-style: none; padding: 0; border-top: 1px solid var(--line); }
  .ind a {
    display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; align-items: baseline;
    padding-block: 2rem; border-bottom: 1px solid var(--line); text-decoration: none;
  }
  .ind a:hover h2 { color: var(--accent); }
  @media (max-width: 760px) {
    .pains, .ind a { grid-template-columns: 1fr; }
    .ind a { gap: 0.75rem; }
  }
</style>
