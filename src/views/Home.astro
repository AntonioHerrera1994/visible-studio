---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Eyes from '../components/Eyes.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import NicheExplorer from '../components/sections/NicheExplorer.astro';
import { type Lang, route, t } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;

const services = (await getCollection('services', (s) => s.data.lang === lang && s.data.kind === 'core'))
  .sort((a, b) => a.data.order - b.data.order);
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured).slice(0, 3);
const logoNames = projects.map((p) => p.data.title);

const copy = {
  es: {
    title: 'Estudio creativo de diseño y marketing digital en Tijuana',
    description: 'Visible Studio diseña marcas, sitios web, SEO y campañas para que tu negocio se vea en Tijuana, México y Estados Unidos.',
    h1: 'Hacemos visible a tu negocio.',
    lede: 'Somos un estudio creativo en Tijuana. Diseñamos tu marca y tu sitio web, y hacemos que te encuentren en Google, en las redes y en las respuestas de la IA.',
    primary: 'Agenda tu diagnóstico gratis',
    secondary: 'Ver nuestro trabajo',
    eyesLabel: 'Dos ojos que siguen tu cursor por la página',
    logos: 'Marcas que ya se ven',
    casesTitle: 'Trabajo reciente',
    casesAll: 'Ver los proyectos',
    servicesTitle: '¿Qué te está pasando?',
    servicesLede: 'Empieza por el problema. Nosotros te decimos qué hacer.',
    processTitle: 'Cómo trabajamos',
    process: [
      ['Diagnóstico', 'Revisamos tu marca, tu sitio y tu competencia. En menos de una semana te decimos qué está frenando tu visibilidad.'],
      ['Estrategia', 'Elegimos tu nicho, tus palabras clave y tus canales. Recibes un plan con tiempos y costos antes de empezar.'],
      ['Diseño y desarrollo', 'Creamos la marca, el sitio o la campaña. Revisas avances cada semana, sin sorpresas al final.'],
      ['Medición', 'Seguimos llamadas, formularios y ventas. Ajustamos cada mes según lo que funciona.'],
    ],
    factsTitle: 'Lo que puedes esperar',
    facts: [
      ['< 1 semana', 'para tu primera llamada después de escribirnos'],
      ['4–8 semanas', 'para los primeros entregables de branding'],
      ['3–6 meses', 'para ver resultados de SEO local'],
      ['2 idiomas', 'español e inglés, para clientes de ambos lados de la frontera'],
    ],
    includes: 'Incluye',
    faqs: [
      { q: '¿Cuál es la diferencia entre un estudio creativo y una agencia?', a: 'Un estudio trabaja con pocos clientes a la vez y une diseño y estrategia en el mismo equipo. Tú hablas directo con quien diseña tu proyecto.' },
      { q: '¿Con qué tipo de negocios trabajan?', a: 'Sobre todo con clínicas médicas y dentales, inmobiliarias, restaurantes, despachos legales, tiendas en línea y emprendedores.' },
      { q: '¿Trabajan con negocios fuera de Tijuana?', a: 'Sí. Trabajamos a distancia con clientes de todo México y de Estados Unidos, y en persona en Tijuana.' },
      { q: '¿Cómo empezamos?', a: 'Agenda tu diagnóstico gratis. Te llamamos en menos de una semana y después te enviamos una cotización con calendario.' },
    ],
  },
  en: {
    title: 'Creative design and digital marketing studio in Tijuana',
    description: 'Visible Studio designs brands, websites, SEO and campaigns so your business gets seen in Tijuana, Mexico and the United States.',
    h1: 'We make your business visible.',
    lede: 'We are a creative studio in Tijuana. We design your brand and website, and get you found on Google, social media and AI answers.',
    primary: 'Book your free check',
    secondary: 'See our work',
    eyesLabel: 'Two eyes that follow your cursor around the page',
    logos: 'Brands that are already seen',
    casesTitle: 'Recent work',
    casesAll: 'See all projects',
    servicesTitle: 'What is going on?',
    servicesLede: 'Start with the problem. We will tell you what to do.',
    processTitle: 'How we work',
    process: [
      ['Check', 'We review your brand, site and competitors. Within a week we tell you what is holding back your visibility.'],
      ['Strategy', 'We pick your niche, keywords and channels. You get a plan with timelines and costs before we start.'],
      ['Design and build', 'We create the brand, site or campaign. You review progress every week, with no surprises at the end.'],
      ['Measure', 'We track calls, forms and sales, and adjust every month based on what works.'],
    ],
    factsTitle: 'What to expect',
    facts: [
      ['< 1 week', 'to your first call after you reach out'],
      ['4–8 weeks', 'to your first branding deliverables'],
      ['3–6 months', 'to see local SEO results'],
      ['2 languages', 'Spanish and English, for clients on both sides of the border'],
    ],
    includes: 'Includes',
    faqs: [
      { q: 'What is the difference between a creative studio and an agency?', a: 'A studio works with a few clients at a time and keeps design and strategy in one team. You talk directly with the people designing your project.' },
      { q: 'What kind of businesses do you work with?', a: 'Mostly medical and dental clinics, real estate, restaurants, law firms, online stores and founders.' },
      { q: 'Do you work with businesses outside Tijuana?', a: 'Yes. We work remotely with clients across Mexico and the United States, and in person in Tijuana.' },
      { q: 'How do we start?', a: 'Book your free check. We call you within a week and then send a quote with a timeline.' },
    ],
  },
}[lang];

const svcBase = route(lang, 'services');
---

<Base
  lang={lang}
  title={copy.title}
  description={copy.description}
  alternates={{ es: '/es/', en: '/en/' }}
>
  <!-- 1. Hero: los ojos son el momento memorable de todo el sitio -->
  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__eyes" data-reveal="scale">
        <Eyes variant="hero" label={copy.eyesLabel} />
      </div>
      <div class="hero__text">
        <h1 data-reveal="mask">{copy.h1}</h1>
        <p class="lede muted" data-reveal style="--i:2">{copy.lede}</p>
        <div class="hero__actions" data-reveal style="--i:3">
          <a class="btn btn--primary" href={route(lang, 'audit')} data-eyes-attract data-magnetic>{copy.primary}</a>
          <a class="btn btn--ghost" href={route(lang, 'work')} data-eyes-attract>{copy.secondary}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Nosotros: estrategia para locales y nichos (con explorador interactivo) -->
  <NicheExplorer lang={lang} />

  <!-- 3. Logos de clientes en marquesina -->
  <section class="logos" aria-labelledby="logos-h">
    <div class="wrap logos__head">
      <h2 id="logos-h" class="logos__h muted">{copy.logos}</h2>
    </div>
    <div class="marquee">
      {[0, 1].map((copyIndex) => (
        <ul class="marquee__track" aria-hidden={copyIndex === 1 ? 'true' : undefined}>
          {logoNames.map((name) => <li>{name}</li>)}
        </ul>
      ))}
    </div>
  </section>

  <!-- 4. Servicios planteados como problemas, con vista previa que sigue al cursor -->
  <section class="section section--white">
    <div class="wrap">
      <h2 data-reveal="mask">{copy.servicesTitle}</h2>
      <p class="lede muted services__lede" data-reveal>{copy.servicesLede}</p>
      <div class="problems-wrap" data-preview-list>
      <ul class="problems" data-stagger>
        {services.map((s) => (
          <li data-preview data-reveal>
            <a href={`${svcBase}${s.data.slug}/`} class="problem" data-eyes-attract>
              <span class="problem__q">{s.data.problem}</span>
              <span class="problem__a">{s.data.h1}</span>
              <svg class="problem__arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </a>
            <template>
              <p class="pv__title">{copy.includes}</p>
              <ul>{s.data.deliverables.slice(0, 4).map((d) => <li>{d}</li>)}</ul>
            </template>
          </li>
        ))}
      </ul>
      <div class="pv" data-preview-card aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <!-- 5. Proceso: es una secuencia real, por eso va numerado. La línea se dibuja con el scroll. -->
  <section class="section section--green process-sec">
    <div class="wrap">
      <h2 data-reveal="mask">{copy.processTitle}</h2>
      <ol class="process" data-stagger>
        {copy.process.map(([title, text]) => (
          <li data-reveal>
            <h3>{title}</h3>
            <p>{text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 6. Expectativas reales, con contadores -->
  <section class="section">
    <div class="wrap">
      <h2 data-reveal="mask">{copy.factsTitle}</h2>
      <dl class="facts" data-stagger>
        {copy.facts.map(([value, label]) => (
          <div data-reveal>
            <dt data-count>{value}</dt>
            <dd class="muted">{label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- 7. Trabajo reciente -->
  <section class="section section--paper">
    <div class="wrap">
      <div class="head-row">
        <h2 data-reveal="mask">{copy.casesTitle}</h2>
        <a class="btn btn--dark" href={route(lang, 'work')} data-eyes-attract data-reveal>{copy.casesAll}</a>
      </div>
      <div class="cases" data-stagger>
        {featured.map((p) => <div data-reveal><ProjectCard project={p} lang={lang} /></div>)}
      </div>
    </div>
  </section>


  <Faq lang={lang} items={copy.faqs} />
  <FinalCta lang={lang} />
</Base>

<style>
  .hero { padding-block: clamp(2.5rem, 7vw, 6rem) var(--space-l); overflow: hidden; }
  .hero__grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    grid-template-areas: 'text eyes';
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
  }
  .hero__text { grid-area: text; }
  .hero__eyes { grid-area: eyes; }
  .hero h1 {
    font-size: var(--step-4);
    font-weight: 800;
    font-stretch: 76%;
    letter-spacing: -0.045em;
    line-height: 0.92;
    margin-bottom: 1.75rem;
  }
  .hero .lede { margin-bottom: 2.25rem; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .hero__actions .btn { transition: translate 0.25s var(--ease-out), background-color 0.2s, transform 0.25s var(--ease-out); }

  /* Logos en marquesina */
  .logos { padding-block: var(--space-l) 0; overflow: hidden; }
  .logos__head { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.5rem; }
  .logos__h { font-size: var(--step-0); font-weight: 550; letter-spacing: 0; font-stretch: 100%; }
  .marquee {
    display: flex;
    border-block: 1px solid var(--line);
    mask: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .marquee__track {
    display: flex;
    flex: none;
    gap: 4rem;
    padding: 1.75rem 2rem;
    margin: 0;
    list-style: none;
    font-weight: 800;
    font-size: clamp(1.4rem, 2.6vw, 2rem);
    font-stretch: 76%;
    letter-spacing: -0.03em;
    color: color-mix(in srgb, var(--fg) 40%, var(--bg));
    animation: marquee 120s linear infinite;
  }
  .marquee:hover .marquee__track { animation-play-state: paused; }
  @keyframes marquee { to { translate: -100% 0; } }

  .head-row {
    display: flex; align-items: end; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }

  /* Servicios */
  .services__lede { margin-top: 1rem; margin-bottom: 2.5rem; }
  .problems-wrap { position: relative; }
  .problems { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .problem {
    display: grid;
    grid-template-columns: 1.3fr 1fr auto;
    gap: 2rem;
    align-items: center;
    padding-block: 1.6rem;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    transition: padding 0.4s var(--ease-out), color 0.2s;
  }
  .problem__q { font-size: var(--step-2); font-weight: 700; font-stretch: 84%; letter-spacing: -0.02em; line-height: 1.15; }
  .problem__a { color: var(--muted); }
  .problem__arrow { width: 1.6rem; opacity: 0; translate: -10px 0; transition: opacity 0.3s, translate 0.4s var(--ease-out); }
  .problem:hover, .problem:focus-visible { padding-left: 1rem; color: var(--accent-strong); }
  .problem:hover .problem__a { color: var(--fg); }
  .problem:hover .problem__arrow, .problem:focus-visible .problem__arrow { opacity: 1; translate: 0 0; }

  .pv {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 3;
    width: 260px;
    padding: 1.1rem 1.2rem;
    border-radius: 18px;
    background: var(--accent);
    color: var(--on-accent);
    pointer-events: none;
    opacity: 0;
    scale: 0.85;
    rotate: -4deg;
    transition: opacity 0.25s, scale 0.35s var(--ease-spring), rotate 0.35s var(--ease-spring);
  }
  .pv:global(.is-on) { opacity: 1; scale: 1; rotate: 2deg; }
  .pv :global(.pv__title) { font-size: var(--step--1); font-weight: 700; margin-bottom: 0.4rem; opacity: 0.75; }
  .pv :global(ul) { margin: 0; padding-left: 1.1rem; display: grid; gap: 0.2rem; font-weight: 600; font-size: 0.95rem; line-height: 1.3; }

  /* Proceso: la línea superior se llena con el scroll */
  .process {
    position: relative;
    list-style: none;
    counter-reset: step;
    margin: 3rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }
  .process li {
    counter-increment: step;
    position: relative;
    padding-top: 1.25rem;
  }
  .process li::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: currentColor;
    transform-origin: left;
  }
  .process li::before {
    content: counter(step);
    display: block;
    font-size: 3.4rem;
    font-weight: 800;
    font-stretch: 75%;
    line-height: 1;
    margin-bottom: 1rem;
  }
  .process h3 { margin-bottom: 0.6rem; }
  @supports (animation-timeline: view()) {
    .process li::after {
      animation: draw linear both;
      animation-timeline: view();
      animation-range: entry 40% cover 45%;
    }
    @keyframes draw { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  }

  .facts {
    margin: 3rem 0 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }
  .facts dt {
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
    font-weight: 800;
    font-stretch: 76%;
    letter-spacing: -0.03em;
    color: var(--accent);
    line-height: 1;
    margin-bottom: 0.6rem;
    font-variant-numeric: tabular-nums;
  }
  .facts dd { margin: 0; max-width: 24ch; }

  .cases {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }


  @media (max-width: 960px) {
    .hero__grid { grid-template-columns: 1fr; grid-template-areas: 'eyes' 'text'; }
    .hero__eyes { width: min(78%, 360px); }
    .process, .facts { grid-template-columns: 1fr 1fr; }
    .cases { grid-template-columns: 1fr; gap: 2.5rem; }
    .problem { grid-template-columns: 1fr auto; gap: 0.25rem 1rem; }
    .problem__a { grid-row: 2; }
    .problem__arrow { opacity: 1; translate: 0 0; grid-row: span 2; }
  }
  @media (max-width: 560px) {
    .process, .facts { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee__track { animation: none; }
    .marquee { overflow-x: auto; }
  }
</style>
